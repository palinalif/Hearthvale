{
  "name": "raise-sculpt",
  "description": "Raise sculpt tool (the default terrain tool): paint N sculpt strokes (hold A + drift right stick, release A to commit). No cycle needed (raise is index 0).",
  "repeat": 3,
  "stroke_seconds": 4.0,
  "rest_seconds": 1.5,
  "setup": [
    {"do": "sleep", "seconds": 1.0}
  ],
  "stroke": [
    {"do": "telemetry", "label": "pre_stroke"},
    {"do": "button", "button": "a", "pressed": true},
    {"do": "sleep", "seconds": 0.35},
    {"do": "stick_drift", "stick": "right", "x": 0.4, "y": 0.3},
    {"do": "stick", "stick": "right", "x": 0.0, "y": 0.0},
    {"do": "button", "button": "a", "pressed": false},
    {"do": "sleep", "seconds": 0.6},
    {"do": "reset"},
    {"do": "telemetry", "label": "post_stroke"}
  ]
}
